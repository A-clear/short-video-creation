# ==============================================================================
# ショート動画作成ツール - 環境変数テンプレート
# ==============================================================================
#
# 使い方:
#   cp .env.example .env  してから値を埋めてください。
#
# ⚠️ このリポジトリは public です（Functions を GitHub の raw URL から取り込むため）。
#    .env は .gitignore 済みですが、実際の鍵をこのテンプレート側に書き戻さないでください。
#
# 変数名はすべて Open WebUI v0.11.0 の実ソースと照合済みです。
#   backend/open_webui/env.py  … 起動時に読まれる（再起動が必要）
#   backend/open_webui/config.py … PersistentConfig。初回起動時に DB へ取り込まれ、
#                                  以降は管理画面の値が優先される（下記「※PC」参照）
#
# ※PC = PersistentConfig。環境変数は「初回の既定値」として働き、その後は
#        Admin Settings の値が正になります。値を変えたいときは管理画面で操作するか、
#        DB の config を消してから再起動してください。
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. 必須 — これが無いと動きません
# ------------------------------------------------------------------------------

# セッション JWT と OAuth トークンの暗号化に使う鍵。（env.py:716）
# v0.11.0 以降は未設定だと backend が起動しません。
# Descript MCP のような OAuth 連携ツールを使う場合、この値が変わると
# 保存済みトークンを復号できなくなり "Error decrypting tokens" が発生します。
# 複数レプリカ構成では全レプリカで必ず同一の値にしてください。
#   生成例: openssl rand -hex 32
WEBUI_SECRET_KEY=

# OAuth セッショントークンの暗号化鍵。未設定なら WEBUI_SECRET_KEY が使われます。
# 複数レプリカでは明示的に固定することを推奨します。
OAUTH_SESSION_TOKEN_ENCRYPTION_KEY=

# Functions / Tools（プラグイン）の実行を許可する。（env.py:1112）
# false にすると Actions / Filters / Pipes がすべて動きません。
ENABLE_PLUGINS=true

# 公開 URL。Web Search など一部機能が参照します。（config.py:1620）※PC
WEBUI_URL=http://localhost:8080


# ------------------------------------------------------------------------------
# 2. データベース（PostgreSQL）
# ------------------------------------------------------------------------------

# （env.py:267）パスワードに記号を含む場合は URL エンコードすること（@ → %40）
DATABASE_URL=postgresql://openwebui:CHANGE_ME@postgres:5432/openwebui

# コネクションプール。（env.py:302-324）
# 総接続数 = (POOL_SIZE + MAX_OVERFLOW) × プロセス数 × レプリカ数
# PostgreSQL の max_connections を超えないように設計してください。
DATABASE_POOL_SIZE=15
DATABASE_POOL_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# マイグレーション。（env.py:151）
# ⚠️ 複数レプリカ構成では 1 台だけ true にし、他は false にしてください。
#    全台で true だと同時マイグレーションで競合します。
# ⚠️ レプリカだけでなく **ワーカー間でも同じ競合が起きます**（6 節参照）。
#    バージョンアップ直後の初回起動は UVICORN_WORKERS=1 で行ってください。
ENABLE_DB_MIGRATIONS=true

# ユーザの最終アクティブ時刻を DB に書き戻す間隔（秒）。（env.py:356）
# 未設定だとリクエストごとに書き込みが走り、スケール時のボトルネックになります。
DATABASE_USER_ACTIVE_STATUS_UPDATE_INTERVAL=300


# ------------------------------------------------------------------------------
# 3. 共有状態ストア（Redis）
# ------------------------------------------------------------------------------
#
# ⚠️ 複数レプリカ / 複数ワーカー構成では Redis が必須です。
#    Functions が使う __event_emitter__ / __event_call__ は Socket.IO 経由で
#    ブラウザと通信しますが、WebSocket 接続を持つのは 1 つのレプリカだけです。
#    Redis 無しだと、別レプリカで動いた Pipe の進捗表示や入力フォームが
#    ユーザに届かず、__event_call__ は 300 秒でタイムアウトします。

REDIS_URL=redis://redis:6379/0

# （env.py:450 / :453 / :470）
ENABLE_WEBSOCKET_SUPPORT=true
WEBSOCKET_MANAGER=redis
WEBSOCKET_REDIS_URL=redis://redis:6379/0

# __event_call__（入力フォーム・確認ダイアログ）の応答待ち上限（秒）。（env.py:502）
# 既定 300。Functions 側の confirm_timeout_sec はこの値未満に設定してください。
WEBSOCKET_EVENT_CALLER_TIMEOUT=300

# Redis の健全性チェック間隔（秒）。長時間アイドル後の接続断対策。
REDIS_HEALTH_CHECK_INTERVAL=60


# ------------------------------------------------------------------------------
# 4. ベクトル DB（PGVector）
# ------------------------------------------------------------------------------
#
# ⚠️ 既定の ChromaDB は SQLite ベースで fork-safe ではないため、
#    UVICORN_WORKERS > 1 や複数レプリカ構成ではクラッシュします。必ず変更してください。

VECTOR_DB=pgvector

# （config.py:638）未指定なら DATABASE_URL が使われます。
PGVECTOR_DB_URL=postgresql://openwebui:CHANGE_ME@postgres:5432/openwebui

# ⚠️ text-embedding-3-large は 3072 次元です。
#    pgvector の通常インデックスは 2000 次元までなので halfvec が必須です。（config.py:645）
PGVECTOR_USE_HALFVEC=true
PGVECTOR_INITIALIZE_MAX_VECTOR_LENGTH=3072

# インデックス方式。（未指定なら作成しない）
PGVECTOR_INDEX_METHOD=hnsw
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64

# 非スーパーユーザで運用する場合は false にし、
# 事前に CREATE EXTENSION vector; を実行しておいてください。
PGVECTOR_CREATE_EXTENSION=true


# ------------------------------------------------------------------------------
# 5. 共有ファイルストレージ（MinIO / S3 互換）
# ------------------------------------------------------------------------------
#
# 制御対象はアップロードファイルのみです。DB とベクトル DB には影響しません。

STORAGE_PROVIDER=s3

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=open-webui
S3_REGION_NAME=ap-northeast-1

# MinIO は仮想ホスト形式の DNS を持たないため path 形式が必要です。（config.py:154）
S3_ADDRESSING_STYLE=path

# Cloudflare R2 を使う場合は必ず false にしてください（タグ API 非対応）。
S3_ENABLE_TAGGING=false


# ------------------------------------------------------------------------------
# 6. ワーカーと同時実行
# ------------------------------------------------------------------------------

# （env.py:442。backend/start.sh:100-105 が --workers に渡す）
# 1 コンテナ内でアプリケーションプロセスを複数起動します。公式スケーリング
# ガイドの Step 3 Option B にあたり、PostgreSQL（2 節）と Redis（3 節）が
# 揃っていることが前提です。本構成は両方揃っているため 1 から引き上げます。
#
# ⚠️ 引き上げる前に、以下がすべて満たされていることを確認してください。
#    ・VECTOR_DB=pgvector（4 節）— 既定の ChromaDB は fork-safe ではありません
#    ・REDIS_URL / WEBSOCKET_REDIS_URL（3 節）— 無いと WebSocket が
#      別ワーカーに落ちて __event_call__ が 300 秒でタイムアウトします
#    ・ENABLE_PIP_INSTALL_FRONTMATTER_REQUIREMENTS=false（11 節）—
#      ワーカーが同時に pip install して競合します
#    ・STORAGE_PROVIDER=s3（5 節）— アップロードファイルの共有
#
# ⚠️ **Open WebUI のバージョンを上げた直後だけは 1 に戻してください。**
#    マイグレーションは config.py:78 のモジュール読み込み時に走り、
#    --workers N では N プロセスが同時に alembic upgrade を実行します。
#    しかも config.py:73-75 が例外を握り潰す（log.exception のみで
#    再送出しない）ため、スキーマが壊れても起動は成功します。
#    手順: UVICORN_WORKERS=1 で起動 → 完了を待つ → 停止 → 元の値で再起動。
#
# ⚠️ DB 接続数は (POOL_SIZE + MAX_OVERFLOW) × このワーカー数 × レプリカ数
#    です。既定値では (15 + 20) × 4 = 140 で、compose の
#    max_connections=200 に収まります。さらに --scale する場合は
#    postgres 側の max_connections を先に引き上げてください。
UVICORN_WORKERS=4

# 同期処理を逃がすスレッドプールのサイズ。（config.py:2081）
# 既定 40 は少なすぎて、同時接続が増えると応答が固まります。
# ⚠️ **ワーカーごとの値**です。UVICORN_WORKERS=4 なら上限は 4 プロセス分。
#    スレッドは必要になった時点で作られるため常時 8000 本立つわけでは
#    ありませんが、Docling への変換要求（retrieval/loaders/main.py:197 の
#    requests.post。タイムアウト指定が無い）は 1 件がスレッドを 1 本
#    占有し続けます。滞留の上限は docling-serve 側の
#    DOCLING_SERVE_MAX_SYNC_WAIT（13 節）で決まります。
THREAD_POOL_SIZE=2000

# より高速な JSON エンコーダ（v0.11.0 以降）。
ENABLE_ORJSON=true

# ロードバランサ / CDN 側で圧縮している場合は false にすると
# ワーカーあたり 3〜4% の CPU を削減できます。
# ENABLE_COMPRESSION_MIDDLEWARE=false


# ------------------------------------------------------------------------------
# 7. LLM プロバイダ（OpenAI）
# ------------------------------------------------------------------------------

ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# --- メイン LLM ---
# gpt-5.4-2026-03-05 を使います。
# ⚠️ 使用モデルは環境変数ではなく Workspace → Models のプリセットで指定します。
#    ここでは既定パラメータのみ設定します。

# ツール呼び出しは Native モード（v0.10.0 以降の既定かつ唯一のサポート対象）。
# ⚠️ FUNCTION_CALLING_MODE のような単独の環境変数は存在しません。
#    DEFAULT_MODEL_PARAMS の JSON 内のキーとして指定します。（config.py:1692）
DEFAULT_MODEL_PARAMS={"function_calling":"native"}

# --- タスクモデル（タイトル生成・タグ生成などの裏方処理）---
# メインモデルより軽量なものを指定すると遅延とコストを大幅に削減できます。（config.py:2158）※PC
TASK_MODEL_EXTERNAL=gpt-5.4-mini-2026-03-17

# --- Embedding（text-embedding-3-large / 3072 次元）---
RAG_EMBEDDING_ENGINE=openai                        # config.py:984  ※PC
RAG_EMBEDDING_MODEL=text-embedding-3-large         # config.py:990  ※PC
RAG_EMBEDDING_BATCH_SIZE=100
ENABLE_ASYNC_EMBEDDING=true

# --- 画像生成（gpt-image-2-2026-04-21）---
ENABLE_IMAGE_GENERATION=true                       # config.py:1310 ※PC
IMAGE_GENERATION_ENGINE=openai                     # config.py:1312 ※PC
IMAGE_GENERATION_MODEL=gpt-image-2-2026-04-21      # config.py:1314 ※PC
# gpt-image 系は IMAGE_AUTO_SIZE_MODELS_REGEX_PATTERN（既定 ^gpt-image）に
# マッチするため auto を指定できます。
IMAGE_SIZE=auto

# --- STT（gpt-transcribe）---
AUDIO_STT_ENGINE=openai                            # config.py:1545 ※PC
AUDIO_STT_MODEL=gpt-transcribe                     # config.py:1547 ※PC

# --- TTS（gpt-4o-mini-tts-2025-12-15）---
AUDIO_TTS_ENGINE=openai                            # config.py:1594 ※PC
AUDIO_TTS_MODEL=gpt-4o-mini-tts-2025-12-15         # config.py:1597 ※PC
AUDIO_TTS_VOICE=alloy                              # config.py:1599 ※PC

# --- Realtime（gpt-realtime-2.1）---
# ⚠️ 未確定 / 現時点では設定不可。
#    Open WebUI v0.11.0 には OpenAI Realtime API に接続するための設定項目が
#    存在しません（ENABLE_REALTIME_CHAT_SAVE は「ストリーミング中にトークン毎に
#    DB へ書き込む」という別機能で、本番では有効化しないでください）。
#    Voice Mode は ENABLE_VOICE_MODE_PROMPT / VOICE_MODE_PROMPT_TEMPLATE という
#    プロンプト設定のみで、Realtime API の接続設定ではありません。
#    Realtime を使う場合は別途 Pipe Function として実装する必要があります。
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1   ← 存在しない変数。設定しても無視されます


# ------------------------------------------------------------------------------
# 8. Web 検索（Tavily）
# ------------------------------------------------------------------------------

ENABLE_WEB_SEARCH=true                             # config.py:1129 ※PC
WEB_SEARCH_ENGINE=tavily                           # config.py:1138 ※PC
TAVILY_API_KEY=                                    # config.py:1266 ※PC
TAVILY_EXTRACT_DEPTH=basic                         # config.py:1268 ※PC
WEB_SEARCH_RESULT_COUNT=3


# ------------------------------------------------------------------------------
# 9. MCP（Descript MCP）
# ------------------------------------------------------------------------------
#
# ⚠️ Descript MCP は環境変数では設定できません。
#    管理画面から登録してください:
#      Admin Settings → External Tools → ＋
#        Type:      MCP (Streamable HTTP)
#        URL:       https://api.descript.com/v2/mcp
#        Auth:      OAuth 2.1
#        → Register Client → Save
#    登録後に表示される info.id を、Functions の Valve
#    `mcp_server_id`（descript_pipe / descript_guard）に設定します。
#
#    さらに、各ユーザがチャット入力欄の ＋ → Integrations → Tools から
#    Descript を一度手動で有効化し、OAuth 同意を完了する必要があります。
#    ⚠️ この MCP をモデルのデフォルトツールに設定してはいけません
#       （チャット補完リクエスト中にブラウザリダイレクトを起こせないため）。
#
#    詳細は docs/Setup/descript_functions_setup.md を参照してください。

# MCP セッション初期化のタイムアウト（秒）。（env.py:653）
# 既定 10 秒。"Failed to connect to MCP server" が出る場合は増やしてください。
MCP_INITIALIZE_TIMEOUT=30

# 外部ツールサーバへユーザ情報ヘッダを転送する。
# Descript MCP 側では使いませんが、監査ログを取る場合に有用です。
ENABLE_FORWARD_USER_INFO_HEADERS=false


# ------------------------------------------------------------------------------
# 10. 認証（Google OAuth / OIDC）
# ------------------------------------------------------------------------------

# 社内ドメイン以外のアカウントを入口で弾く。カンマ区切り。既定 * は全許可。
# （config.py:2575）
OAUTH_ALLOWED_DOMAINS=example.com

# 新規ユーザのロール。pending にすると管理者が承認するまでログインできない。
# ⚠️ PersistentConfig。初回起動時にしか取り込まれない（config.py:1699 →
#    ui.default_user_role）。起動済みの環境では Admin Settings → Users で変更する。
#
# ⚠️ Google OAuth 単体ではロール / グループの自動同期ができない。
#    GOOGLE_OAUTH_SCOPE の既定が openid email profile（config.py:2465）で
#    roles / groups クレームが返らず、ENABLE_OAUTH_ROLE_MANAGEMENT の実装
#    （utils/oauth.py:1488）は 3 つの条件が揃わないとロール判定に入らないため。
#    グループは Admin Settings → Users → Groups で手動運用する。
DEFAULT_USER_ROLE=pending

ENABLE_OAUTH_SIGNUP=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPE=openid email profile
GOOGLE_REDIRECT_URI=https://XXXX/oauth/google/callback
OPENID_PROVIDER_URL=https://accounts.google.com/.well-known/openid-configuration

# 本番では短めにしてください。
JWT_EXPIRES_IN=4h

# スケール時のセキュリティ既定の見直し。
ENABLE_PROFILE_IMAGE_URL_FORWARDING=false
ENABLE_OAUTH_ID_TOKEN_COOKIE=false


# ------------------------------------------------------------------------------
# 11. プラグインの依存関係インストール
# ------------------------------------------------------------------------------
#
# Functions の frontmatter に書かれた requirements を pip install するかどうか。
#
# ⚠️ 本番では false を推奨します。理由:
#    ① 任意パッケージのインストールを防げる
#    ② UVICORN_WORKERS > 1 や複数レプリカで同時 pip install が走ると
#       競合でワーカーがクラッシュする
#    ③ デプロイが再現可能になる
#
#    本プロジェクトの 3 つの Functions は requirements を空にしてあり、
#    Open WebUI 同梱の mcp / httpx / pydantic と標準ライブラリしか使いません。
#    したがって false でも動作します。
ENABLE_PIP_INSTALL_FRONTMATTER_REQUIREMENTS=false


# ------------------------------------------------------------------------------
# 12. PWA / ブランディング
# ------------------------------------------------------------------------------
#
# Open WebUI のインスタンスはそのまま PWA として動作します（追加設定不要）。
# ブラウザの「ホーム画面に追加」/「インストール」でスタンドアロンアプリになります。
# ⚠️ ENABLE_PWA のような変数は存在しません。

WEBUI_NAME="Open WebUI - Astyle"

# アプリ名・アイコン・テーマカラーを差し替える場合は
# 外部の manifest を指定します。（env.py:951）
# EXTERNAL_PWA_MANIFEST_URL=https://example.com/manifest.webmanifest


# ------------------------------------------------------------------------------
# 13. Basic RAG（コンテンツ抽出 / チャンク分割 / 検索）
# ------------------------------------------------------------------------------
#
# 本プロジェクトの Basic RAG は次の 3 点構成です。
#   Embedding engine        : OpenAI（text-embedding-3-large。7 節で設定）
#   Content extraction      : Docling（docker-compose.yml の docling-serve）
#   Vector database         : PGVector（4 節で設定）
#
# ⚠️ **この節の値はすべて PersistentConfig です。**（config.py:2828-2894）
#    取り込まれるのは Open WebUI の初回起動時だけで、起動済みの環境では
#    .env を書き換えてもエラーも警告も出ずに無視されます。既存環境では
#    Admin Settings → Tools → Documents で同じ値を手入力してください。

# --- コンテンツ抽出（Docling）---
# 既定の pypdf は継続的な取り込みでメモリリークします。（config.py:854）
CONTENT_EXTRACTION_ENGINE=docling

# docling-serve の到達先。docker-compose.yml の open-webui サービス側で
# コンテナ名に上書きしているため、単体起動する場合だけここを使います。
# ⚠️ 上流の既定は http://docling:5001 で、compose のサービス名と違います。
DOCLING_SERVER_URL=http://docling-serve:5001

# docling-serve の API キー。設定すると Open WebUI が X-Api-Key ヘッダで
# 送ります（retrieval/loaders/main.py:194-195）。
# ⚠️ このエンドポイントは「任意のファイルを投げると変換して返す口」です。
#    ネットワークは分離してありますが、キーも必ず設定してください。
#      生成例: openssl rand -hex 32
DOCLING_API_KEY=

# Docling へ渡す変換オプション。JSON オブジェクトで、docling-serve へは
# multipart のフォーム値としてそのまま転送されます（同 :206-213）。
# ⚠️ JSON が壊れていると config.py:927-930 が {} にフォールバックし、
#    警告も出ないまま既定値で動きます。
#
# ⚠️ **do_ocr: true は独自イメージが前提です。** 公開イメージに入っている
#    tesseract の言語パックは英語のみ（docling-serve の os-packages.txt に
#    tesseract-langpack-eng しか無い）で、そのまま日本語のスキャン PDF に
#    OCR をかけると文字化けした本文がベクトル DB に入り、検索結果を
#    汚染します。docker/docling/Dockerfile で tesseract-langpack-jpn /
#    -jpn_vert を足しているため、この設定が成立します。
#    **必ず docker compose build を流してから使ってください。**
#
# ⚠️ ocr_lang は「英語のみ」を先に消さないこと。日本語文書にも英数字
#    （製品名・URL・数値）が混ざるため jpn と eng を併記します。
#    tesseract の言語コードは 3 文字（ISO 639-2）です。easyocr に切り替える
#    場合だけ 2 文字（ja / en）になります。
#
# ⚠️ **縦書きは jpn_vert を明示的に足す必要があります。** tesseract は
#    自動で切り替えません。言語パック自体はイメージに入れてあるので、
#    縦組みの文書を扱うときだけ ocr_lang を ["jpn","jpn_vert","eng"] に
#    してください（横組みの認識精度が落ちるため既定では入れていません）。
#
# ⚠️ OCR は CPU を使います。デジタル PDF（大半の社内文書）は OCR 無しでも
#    dlparse が本文を取り出せるため、取り込み速度が問題になる場合は
#    force_ocr を絶対に true にしないでください（デジタル PDF にも
#    強制的に OCR がかかります）。
DOCLING_PARAMS={"do_ocr":true,"ocr_engine":"tesseract","ocr_lang":["jpn","eng"],"pdf_backend":"dlparse_v4","table_mode":"accurate"}

# --- チャンク分割（Admin Settings → Documents に対応）---
# 公式の推奨開始値。既定値（character / 1000 / 100）より明確に精度が上がります。
#
# ⚠️ token を選ぶと tiktoken の cl100k_base が必要です（routers/retrieval.py:1709-1720）。
#    公式イメージは /app/backend/data/cache/tiktoken に焼き込み済みなので
#    追加のダウンロードは発生しません（Dockerfile:98-99, 151）。
#    ただし **open-webui-data ボリュームを bind mount に変えるとこの
#    キャッシュが消え**、初回利用時に外部への取得が走ります。
RAG_TEXT_SPLITTER=token
TIKTOKEN_ENCODING_NAME=cl100k_base

# 見出しで先に区切ってからチャンク化する。（config.py:1039。既定 true）
ENABLE_MARKDOWN_HEADER_TEXT_SPLITTER=true

CHUNK_SIZE=2000
CHUNK_OVERLAP=200

# --- 検索 ---
# 取得するチャンク数。（config.py:952。既定 3）
RAG_TOP_K=15

# ナレッジベースをファイルシステム風のインターフェース（ls / tree / grep /
# cat）としてモデルに渡す。（env.py:906。既定 false）
# ⚠️ **PersistentConfig ではない素の環境変数**なので、この 1 つだけは
#    起動済みの環境でも .env の変更が再起動で反映されます。
# ⚠️ 効くのは Native 関数呼び出しのときだけです。本構成は 7 節で
#    function_calling=native を指定しているため有効に働きます
#    （legacy だと utils/middleware.py:2466 の旧 RAG 注入経路になります）。
ENABLE_KB_EXEC=true


# ------------------------------------------------------------------------------
# 14. Open Terminal（AI の実行環境）
# ------------------------------------------------------------------------------
#
# docker-compose.yml の open-terminal サービス用の設定です。
# Open WebUI 本体はこれらの OPEN_TERMINAL_* を読みません。compose が
# コンテナへ渡すために参照します（Open WebUI 側は下の接続定義だけ見ます）。
#
# 接続定義 TERMINAL_SERVER_CONNECTIONS は docker-compose.yml の
# open-webui サービス内で組み立てているため、ここには書きません。
# 単体で Open WebUI を動かす場合だけ、以下の形で指定してください。※PC
#   TERMINAL_SERVER_CONNECTIONS=[{"id":"open-terminal","name":"作業用ターミナル","url":"http://open-terminal:8000","key":"<OPEN_TERMINAL_API_KEY と同じ値>","auth_type":"bearer","enabled":true,"config":{"access_grants":[]}}]
#
# ⚠️ この変数は config.py:386 で json.loads されますが、TOOL_SERVER_CONNECTIONS と
#    違って try/except がありません。JSON を壊すと Open WebUI が起動しません。
# ⚠️ ※PC なので取り込まれるのは初回起動時だけです。値を変えたら
#    Admin Settings → Integrations → Open Terminal で直すか、
#    DB の terminal_server.connections を削除してから再起動してください。
# ⚠️ access_grants は空 [] が本構成の初期値です。空 / 未指定は「管理者のみ」に
#    倒れます（utils/access_control/__init__.py:171）。これは意図的です。
#    グループ ID はグループを作るまで存在せず、この変数は初回起動時にしか
#    取り込まれない（models/config.py:256）ため、ここにグループ grant を
#    書けません。起動後に Admin Settings → Integrations で
#    {"principal_type":"group","principal_id":"<group_id>","permission":"read"}
#    を 3 チーム分付けてください。

# ターミナルの認証キー。v0.11.30 以降は未設定だと Open Terminal が起動しません。
# このキーを持っていれば誰でもコマンドを実行できるため、必ず強い値にしてください。
#   生成例: openssl rand -hex 32
OPEN_TERMINAL_API_KEY=

# 同時ターミナルセッション数の上限。
# ⚠️ コンテナ全体の合計上限であり、ユーザ単位ではありません（main.py:1899 が
#    len(_terminal_sessions) をグローバルに数える）。人数分引き上げてください。
OPEN_TERMINAL_MAX_SESSIONS=32

# ⚠️ マルチユーザモードは docker-compose.yml 側で "true" に固定しています。
#    ユーザごとに Linux アカウントと home が作られ、ファイルが分離されます。
#    分離されないもの（セッション・プロセス出力・ポート・リソース）については
#    docs/Setup/multi_user_setup.md の「既知の限界」を参照してください。

# コマンド出力を待つ秒数。未設定だと無期限に待ちます。
# ffmpeg のエンコードを走らせる想定で長めにしています。
OPEN_TERMINAL_EXECUTE_TIMEOUT=600

# 暴走したスクリプト対策のリソース上限（compose の deploy.resources.limits）。
OPEN_TERMINAL_MEMORY_LIMIT=2G
OPEN_TERMINAL_CPU_LIMIT=2.0

# 検証時にホストへ直接公開する場合のポート。
# docker-compose.yml 側の ports がコメントアウトされているため、
# 有効化しない限りこの値は使われません。
OPEN_TERMINAL_PORT=8000


# ------------------------------------------------------------------------------
# 15. Open WebUI Computer（実マシン相当のエージェントワークスペース）
# ------------------------------------------------------------------------------
#
# docker-compose.yml の open-webui-computer-a / -b / -c サービス用の設定です。
# Open Terminal とは別物で、Open WebUI の「部品」ではなく独立した 1 つのアプリです。
#   - 自前のログイン画面・自前の PWA・自前のエージェントランタイムを持つ
#   - Open WebUI からは gateway（OpenAI 互換 API）経由で
#     `cptr/<workspace>` というモデルとして見える
#
# ⚠️ Open Terminal と違い、ホストへのポート公開が必須です。
#    ブラウザが Open WebUI のバックエンドを経由せず直接 Socket.IO でつなぐためです。
# ⚠️ セキュリティモデルは「サインインしたユーザ = SSH 相当の全権」。
#    ユーザ間の分離はありません。境界は compose でマウントしたディレクトリだけです。
#    生の公開インターネットに出さないでください。
#
# --- 初回セットアップの順序（ここを飛ばすと接続が作れません。team-a / -b / -c の 3 回分）---
#   ① docker compose up -d open-webui-computer-a open-webui-computer-b open-webui-computer-c
#   ② docker compose logs open-webui-computer-a（-b / -c も同様に確認）
#      → `http://localhost:8001/?token=...`（-b は 8002、-c は 8003）が出る。
#        ユーザが 1 人も居ない間だけ有効な使い捨て URL で、ここで作ったアカウントが admin になります。
#   ③ 各 Computer の Settings → Admin → Connections で LLM プロバイダを登録
#      （OpenAI / Anthropic の 2 種類のみ。環境変数では設定できません）
#        LLM:       gpt-5.4-2026-03-05
#        STT / TTS: Settings → Audio（gpt-transcribe / gpt-4o-mini-tts-2025-12-15）
#      ※ Embedding / 画像生成 / Realtime は Computer 側の設定項目にありません。
#        それらは Open WebUI 本体（上の「6. プロバイダ」節）の担当です。
#   ④ 各 Computer の Settings → Admin → Gateway で個別に API キーを発行し、下の
#      OPEN_WEBUI_COMPUTER_GATEWAY_KEY_A / _B / _C にそれぞれ貼る
#      ⚠️ sk-cptr-... は発行時に 1 回しか表示されません（以降はハッシュ保存）。
#   ⑤ OPEN_WEBUI_COMPUTER_ENABLED_A / _B / _C を true にしてから Open WebUI を初回起動
#
# ⚠️ Open WebUI 側の接続定義（OPENAI_API_BASE_URLS / OPENAI_API_KEYS /
#    OPENAI_API_CONFIGS）は docker-compose.yml の open-webui サービス内で
#    組み立てています。いずれも ※PC なので、取り込まれるのは Open WebUI の
#    初回起動時だけです。既に起動済みの環境で足す場合は
#    Admin Settings → Connections から手で登録してください（team-a の例。
#    -b / -c も同様にホスト名とポートを読み替える）:
#      Base URL: http://open-webui-computer-a:8000/v1
#      API Key:  sk-cptr-...
#      Headers:  {"X-OpenWebUI-Chat-Id":"{{CHAT_ID}}",
#                 "X-OpenWebUI-Message-Id":"{{MESSAGE_ID}}",
#                 "X-OpenWebUI-User-Message-Id":"{{USER_MESSAGE_ID}}",
#                 "X-OpenWebUI-User-Message-Parent-Id":"{{USER_MESSAGE_PARENT_ID}}",
#                 "X-OpenWebUI-Task":"{{TASK}}"}
#    ヘッダを省くと素のチャットは動きますが、会話の継続・編集/再生成の分岐同期・
#    裏方タスク（タイトル/タグ生成）の除外が効きません。

# --- team-a ---------------------------------------------------------------
OPEN_WEBUI_COMPUTER_PORT_A=8001
OPEN_WEBUI_COMPUTER_URL_A=http://localhost:8001
# ⚠️ 各 Computer の Settings → Admin → Gateway で発行します。
#    sk-cptr-... は 1 回しか表示されず、以降はハッシュ保存です。
OPEN_WEBUI_COMPUTER_GATEWAY_KEY_A=
OPEN_WEBUI_COMPUTER_ENABLED_A=false

# --- team-b ---------------------------------------------------------------
OPEN_WEBUI_COMPUTER_PORT_B=8002
OPEN_WEBUI_COMPUTER_URL_B=http://localhost:8002
OPEN_WEBUI_COMPUTER_GATEWAY_KEY_B=
OPEN_WEBUI_COMPUTER_ENABLED_B=false

# --- team-c ---------------------------------------------------------------
OPEN_WEBUI_COMPUTER_PORT_C=8003
OPEN_WEBUI_COMPUTER_URL_C=http://localhost:8003
OPEN_WEBUI_COMPUTER_GATEWAY_KEY_C=
OPEN_WEBUI_COMPUTER_ENABLED_C=false

# ⚠️ コンテナ内で立てた開発サーバをホストで見る方法:
#    Computer の Browser タブ / Port Preview を使ってください
#    （HTTP プロキシ型。http://localhost:5173 をそのまま開けます）。
#    ホストからは各 Computer の公開ポート経由で見えるため、追加のポート公開は
#    不要です。WebSocket もトンネルされるので HMR も通ります。
#
# ⚠️ 開発サーバのポート公開は廃止しました。複数人だと 2 人目の vite が
#    5173 を取れず（EADDRINUSE）5174 へずれ、公開していないので見えません。
#    固定ポートの公開は構造的に複数人と両立しません。
#
# ⚠️ Browser タブの「モード」は proxy のままにしてください
#    （Settings → Admin → Browser）。chrome モードは CDP 方式で、
#    このイメージに Chrome は入っていないため 409 で失敗します。

# run_command が返るまでの待ち秒数。未設定だとコマンドを待たずに即返ります。
# ffmpeg のエンコードを待たせる想定で長めにしています。
OPEN_WEBUI_COMPUTER_EXECUTE_TIMEOUT=600

# ログ。既定は INFO / text。
OPEN_WEBUI_COMPUTER_LOG_LEVEL=INFO

# 監査ログ。既定は NONE（無効）。
#   NONE / METADATA（変更系リクエスト）/ REQUEST / REQUEST_RESPONSE
# ⚠️ 端末操作の全文ログではなく、API レベルの記録です。
OPEN_WEBUI_COMPUTER_AUDIT_LOG_LEVEL=METADATA

# リソース上限（compose の deploy.resources.limits）。3 台合計で
# 9G / 6 CPU がホストに要求されます。
OPEN_WEBUI_COMPUTER_MEMORY_LIMIT=3G
OPEN_WEBUI_COMPUTER_CPU_LIMIT=2.0
OPEN_WEBUI_COMPUTER_MEMORY_RESERVATION=1G

# Web 検索は上の TAVILY_API_KEY を compose がそのまま渡します。
# ⚠️ Computer 側の優先順は Exa → Perplexity → Tavily → Brave → Firecrawl →
#    SearXNG → DuckDuckGo。EXA_API_KEY / PERPLEXITY_API_KEY を足すと
#    Tavily より先に使われるので設定しないでください。


# ------------------------------------------------------------------------------
# 16. Computer のイメージ（開発ツールチェーン + Codex）
# ------------------------------------------------------------------------------
#
# open-webui-computer-a / -b / -c だけは公式イメージをそのまま使わず、
# docker/computer/Dockerfile でビルドします。3 台とも同じ image: タグを指すため、
# ビルドは実質 1 回（BuildKit のキャッシュが効く）です。
#
# ⚠️ 公式イメージ ghcr.io/open-webui/computer:latest は意図的に最小構成で、
#    入っているのは git / openssl / tar / Python 3.12（+ pip, uv）だけです。
#    node も npm も curl も gcc も無く、非 root ユーザ cptr（uid 1000）で動きます。
#    apt パッケージは実行中のコンテナには足せない（sudo が無い）ため、
#    起動時インストールではなくビルドが必要になります。
#
# 足しているもの:
#   apt … build-essential / curl / wget / jq / ripgrep / git-lfs /
#         openssh-client / unzip / xz-utils / less / vim / procps
#   Node … node / npm / npx / corepack（公式イメージからバイナリを移植）
#   npm -g … pnpm / typescript / tsx
#   codex … coding agent subscription 用の CLI（/usr/local/bin/codex）
#
# ⚠️ 反映には明示的なビルドが必要です。`docker compose up -d` だけでは
#    既存イメージが再利用されます。
#      docker compose build
#      docker compose up -d open-webui-computer-a open-webui-computer-b open-webui-computer-c

# --- ベースイメージ ---
# :latest が安定版、:dev が main 追従。
OPEN_WEBUI_COMPUTER_IMAGE=ghcr.io/open-webui/computer:latest

# --- Node.js ---
# ⚠️ 22 系で固定しています。open-webui submodule の engines が
#    `>=18.13.0 <=22.x.x` なので、24 以上にすると submodule のフロントエンドが
#    インストールできなくなります（CLAUDE.md のバージョン制約を参照）。
#    Node 22 は Maintenance LTS（EOL 2027-04-30）、24 が Active LTS。
NODE_VERSION=22

# npm でグローバル導入するもの。
# ⚠️ pnpm は corepack ではなく npm で入れています。corepack のシムは
#    初回実行時にネットワークから pnpm を取りに行くため、
#    「ビルドは通ったのに実行時に落ちる」が起きるためです。
PNPM_VERSION=11.24.0
TYPESCRIPT_VERSION=7.0.2
TSX_VERSION=4.23.12

# --- Codex（coding agent subscription）---
#
# 既に払っている ChatGPT のサブスクリプションを、API キーを使わずに
# チャットのバックエンドとして使う機能です。Open WebUI 本体ではなく
# **Computer（cptr）側**の機能なので、設定場所も Computer の管理画面です。
#
# ⚠️ これは API キー課金ではなくサブスクリプション利用です。
#    上の「7. LLM プロバイダ（OpenAI）」の OPENAI_API_KEY とは別勘定で、
#    どちらを使うかはワークスペース単位で選びます（下記 ④）。
#
# --- セットアップの順序（team-a / -b / -c の 3 回分）---
#   ① docker compose build
#   ② docker compose up -d open-webui-computer-a open-webui-computer-b open-webui-computer-c
#   ③ 各コンテナでログイン（コンテナにブラウザが無いのでデバイスコード方式を使います）
#        docker compose exec -it open-webui-computer-a codex login --device-auth
#      → 表示されたコードを手元のブラウザで承認。-b / -c も同様に個別ログインします
#        （同じ ChatGPT アカウントで 3 回。レート制限は 1 アカウントで共有）。
#        確認は `docker compose exec open-webui-computer-a codex login status`。
#      ⚠️ `codex login`（--device-auth 無し）はローカルの 1455 番ポートに
#        コールバックを待ち受けるため、コンテナでは完了しません。
#   ④ 各 Computer の Settings → Admin → Agents でプロファイルを追加
#        Name:       Codex
#        Type:       Codex
#        Profile ID: codex          ← モデル ID の一部になります
#        Command:    /usr/local/bin/codex
#        Home:       （空のまま。既定の ~/.codex を codex-home-<team> が永続化済み）
#      → Status が ready になれば成功。models は空にすると自動検出します。
#   ⑤ Codex に処理させたいワークスペースで `<workspace>/.cptr/model` に
#      モデル ID を 1 行書きます。
#        echo 'agent:codex/gpt-5.4' > /workspace/<name>/.cptr/model
#      → Open WebUI のモデルピッカーの `cptr/<name>` がこの設定で動きます。
#
# ⚠️ ④⑤ は環境変数では設定できません（Computer 側に該当の変数がなく、
#    Agents プロファイルは app.db / config.toml に入ります）。
#
# ⚠️ モデル ID は codex 側のスラッグで、OpenAI API の日付付き ID とは別物です。
#    `agent:codex/gpt-5.4` は有効ですが `agent:codex/gpt-5.4-2026-03-05` は
#    存在しません。実際に選べる一覧は次のコマンドで確認できます。
#      docker compose exec open-webui-computer-a codex debug models（-b / -c も同様）
#
# ⚠️ Open WebUI から gateway 経由で呼ばれた場合、承認プロンプトは出ません
#    （全ツール自動承認）。Codex 側の approval policy / sandbox は Computer が
#    チャットモードに合わせて上書きします。1 つ 1 つ承認したい場合は
#    Open WebUI ではなく Computer の UI から使ってください。

# codex CLI のバージョン。GitHub リリースのタグをそのまま指定します。
#   https://github.com/openai/codex/releases
# ⚠️ 上げたらイメージの再ビルドが必要です（codex はイメージに焼き込まれています）。
CODEX_CLI_VERSION=rust-v0.149.1

# 配布物のターゲット。Apple Silicon や ARM のホストでは
# aarch64-unknown-linux-musl に変えてください。
CODEX_CLI_TARGET=x86_64-unknown-linux-musl


# ------------------------------------------------------------------------------
# 17. Playwright MCP（エージェント用ヘッドレスブラウザ）
# ------------------------------------------------------------------------------
#
# docker-compose.yml の playwright-mcp-a / -b / -c サービス用の設定です。
# Computer の中で立てた dev サーバを「エージェントに操作させる」ための面で、
# 人間が目で見るだけなら Computer の Browser タブ（プロキシ）で足ります。
#
# ⚠️ Computer のイメージには Chromium が要求する共有ライブラリが 1 つも
#    入っていません（libnss3 / libgbm / libxkbcommon など全滅）。cptr は
#    非 root で sudo も apt も無いため、コンテナ内に Playwright を入れても
#    ブラウザ起動時に落ちます。だからブラウザは別コンテナに置いています。
#
# ⚠️ ポートは公開しません。認証なしでブラウザを遠隔操作できる API です。
#    チームの Computer からサービス名で引ければ足ります。
#
# ⚠️ 専用ネットワーク svc-playwright-net-a / -b / -c に載せています。
#    Computer が参加している svc-computer-net-* には open-webui 本体も
#    居るため、そちらに相乗りさせるとブラウザが Open WebUI 本体に
#    到達できてしまいます。
#
# --- セットアップの順序（team-a / -b / -c の 3 回分）------------------------
#   ① docker compose build       ← Computer イメージに mcp-remote を焼き込む
#   ② docker compose up -d playwright-mcp-a playwright-mcp-b playwright-mcp-c
#   ③ 各 Computer（http://localhost:8001 など）→ Settings → Admin → Tools
#      → Add Tool Server を以下で登録する
#          Type    : MCP (stdio)          ← ⚠️ MCP (HTTP) では動きません
#          ID      : playwright
#          Command : mcp-remote
#          Args    : http://playwright-mcp-a:8931/mcp
#                    --transport http-only
#                    --allow-http
#
#   ⚠️ Type を MCP (HTTP) にすると browser_navigate の次の browser_snapshot が
#      about:blank になります。cptr は HTTP MCP をツール呼び出しのたびに
#      接続し直すため、ブラウザのタブが毎回作り直されるからです。
#   ⚠️ --allow-http は必須です。mcp-remote は既定で非 HTTPS を拒否し、
#      cptr 側には "Connection closed" としか出ないため原因が分かりません。
#   詳細と落とし穴は docs/Setup/playwright_mcp_setup.md を参照してください。

# --- イメージ ---
# ⚠️ Docker 版は headless chromium のみ対応です（firefox / webkit は不可）。
PLAYWRIGHT_MCP_VERSION=latest

# --- リソース ---
# ⚠️ shm は既定の 64MB だと Chromium がタブを開いた瞬間に落ちることが
#    知られています。ここは節約しないでください。
PLAYWRIGHT_MCP_SHM_SIZE=1gb
PLAYWRIGHT_MCP_MEMORY_LIMIT=1G
PLAYWRIGHT_MCP_CPU_LIMIT=1.0

# --- ブラウザの挙動 ---
PLAYWRIGHT_MCP_VIEWPORT_SIZE=1280x720
# 返すコンソールログの下限: error / warning / info / debug
PLAYWRIGHT_MCP_CONSOLE_LEVEL=warning

# --- 到達先の制限（任意。空 = 制限なし）------------------------------------
# セミコロン区切りのオリジン許可リスト。ここに書いたオリジン以外へは
# ブラウザが出られなくなります（ERR_BLOCKED_BY_CLIENT）。
#
# ⚠️ 絞ると CDN や Google Fonts も落ち、実ページの描画が崩れます。
#    既定では設定せず、境界はネットワーク分離（svc-playwright-net-*）に
#    任せています。プロンプトインジェクション経由の持ち出しまで塞ぎたい
#    場合だけ、自分の dev サーバのオリジンを列挙してください。
#    ネットワークごと閉じる手もあります（docker-compose.yml の
#    svc-playwright-net-* にある internal: true のコメントを参照）。
#
#    例: PLAYWRIGHT_MCP_ALLOWED_ORIGINS_A=http://open-webui-computer-a:5173;http://open-webui-computer-a:3000
PLAYWRIGHT_MCP_ALLOWED_ORIGINS_A=
PLAYWRIGHT_MCP_ALLOWED_ORIGINS_B=
PLAYWRIGHT_MCP_ALLOWED_ORIGINS_C=


# ------------------------------------------------------------------------------
# 18. マルチユーザ（権限・監査）
# ------------------------------------------------------------------------------
#
# ⚠️ この節の USER_PERMISSIONS_* はすべて PersistentConfig です。
#    DEFAULT_CONFIG 経由で Config.seed_defaults() に渡されますが、この関数は
#    「DB に無いキーだけ INSERT」します（models/config.py:256）。
#    つまり取り込まれるのは初回起動時だけで、2 回目以降は
#    Admin Settings → Users → Groups の値が正になります。
#
# ⚠️ 権限はグループを OR で合成します（utils/access_control/__init__.py:54）。
#    グループは権限を「足す」ことしかできず、奪えません。
#    したがって「既定を false に絞り、許可グループに true を足す」以外の
#    順序は成立しません。ここを逆にすると後から締められなくなります。

# --- 入口の制限（サインアップ）---------------------------------------------
# ⚠️ OAUTH_ALLOWED_DOMAINS（10 節）が塞ぐのは OAuth 経路だけです。
#    ENABLE_SIGNUP の既定は True（config.py:1623）、ENABLE_LOGIN_FORM も
#    True（同 :1625）なので、既定のままだと URL に到達できる誰でも
#    メール/パスワードでアカウント行を作れます。DEFAULT_USER_ROLE=pending
#    （10 節）で承認待ちに落ちるとはいえ、承認待ちリストが外部ユーザで
#    汚れるのを防ぐため、メール/パスワードでの新規登録自体を閉じます。
ENABLE_SIGNUP=false

# --- ナレッジベースの運用（Basic RAG）--------------------------------------
# **管理者が作り、チームに read grant を配る**方針です。既定のまま
# false を維持します（config.py:1716-1717。upstream 既定も false）。
#
# ⚠️ false だと一般ユーザは POST /api/v1/knowledge/create が 401 になります
#    （routers/knowledge.py:286-292）。作成できるのは管理者だけです。
# ⚠️ 一方 **閲覧・利用は塞がりません。** GET /api/v1/knowledge/ は
#    get_verified_user のみ（同 :130）なので、read grant を貰った
#    ナレッジベースはチャットの # から普通に使えます。
# ⚠️ 管理者は filter_allowed_access_grants の対象外です
#    （utils/access_control/__init__.py:249 で早期 return）。下の
#    ..._ALLOW_SHARING=false があっても、管理者が付けたグループ grant は
#    削られません。この方針が成立するのはこの分岐があるためです。
# ⚠️ **モデルに紐付けたナレッジは、モデルの grant とは別にナレッジ自身の
#    read grant が要ります**（retrieval/utils.py:1514-1521）。付け忘れると
#    「モデルは選べるのに検索結果だけ 0 件」という無症状の壊れ方をします。
#    手順は docs/Setup/multi_user_setup.md を参照してください。
USER_PERMISSIONS_WORKSPACE_KNOWLEDGE_ACCESS=false

# --- RAG のアクセス制御バイパス（必ず false）--------------------------------
# ⚠️ この 2 つは PersistentConfig ではない素の環境変数です。.env に書けば
#    再起動のたびに効きます。true にすると 18 節で閉じた認可が RAG 経路
#    だけ丸ごと無効になるため、明示的に false を書いて固定します。
#
# 検索経路の所有者検査を全部飛ばす。（env.py:787。retrieval/utils.py:1489 /
# 1565 / 1590 / 1598 の 4 箇所が分岐し、クライアントが送った collection_name を
# そのままベクトル DB へ投げるようになります）
BYPASS_RETRIEVAL_ACCESS_CONTROL=false

# ナレッジベースに紐付かないコレクション名を既定拒否せず通す。
# （env.py:793。filter_accessible_collections の最終分岐）
ENABLE_RETRIEVAL_UNSCOPED_COLLECTIONS=false

# --- 共有の禁止 -----------------------------------------------------------
# 一般ユーザがワークスペースのリソースやチャットを他人・公開に開く経路を塞ぐ。
# （config.py:1765-1818）
USER_PERMISSIONS_WORKSPACE_MODELS_ALLOW_SHARING=false
USER_PERMISSIONS_WORKSPACE_MODELS_ALLOW_PUBLIC_SHARING=false
USER_PERMISSIONS_WORKSPACE_KNOWLEDGE_ALLOW_SHARING=false
USER_PERMISSIONS_WORKSPACE_KNOWLEDGE_ALLOW_PUBLIC_SHARING=false
USER_PERMISSIONS_WORKSPACE_PROMPTS_ALLOW_SHARING=false
USER_PERMISSIONS_WORKSPACE_PROMPTS_ALLOW_PUBLIC_SHARING=false
USER_PERMISSIONS_WORKSPACE_TOOLS_ALLOW_SHARING=false
USER_PERMISSIONS_WORKSPACE_TOOLS_ALLOW_PUBLIC_SHARING=false
USER_PERMISSIONS_WORKSPACE_SKILLS_ALLOW_SHARING=false
USER_PERMISSIONS_WORKSPACE_SKILLS_ALLOW_PUBLIC_SHARING=false
USER_PERMISSIONS_NOTES_ALLOW_SHARING=false
USER_PERMISSIONS_NOTES_ALLOW_PUBLIC_SHARING=false
USER_PERMISSIONS_FOLDERS_ALLOW_SHARING=false
USER_PERMISSIONS_CHAT_ALLOW_PUBLIC_SHARING=false
USER_PERMISSIONS_CHAT_ALLOW_OPEN_SHARING=false
USER_PERMISSIONS_CALENDAR_ALLOW_PUBLIC_SHARING=false

# --- grant 操作の禁止 -----------------------------------------------------
# filter_allowed_access_grants()（utils/access_control/__init__.py:220-298）は
# 権限の無いユーザが付けた grant をエラーにせず保存時に削ります。
# 一般ユーザが自分のリソースを他人へ開く経路が閉じます。
USER_PERMISSIONS_ACCESS_GRANTS_ALLOW_USERS=false
USER_PERMISSIONS_ACCESS_GRANTS_ALLOW_GROUPS=false

# --- 迂回路の遮断（既定 false。明示して維持する）--------------------------
#
# ⚠️ direct_tool_servers は特に重要です。ユーザ個人設定からの direct 接続には
#    access_grants が付かず（AddTerminalServerModal.svelte:359 が !direct の
#    ときだけ付与）、ブラウザが Open Terminal を直叩きするため X-User-Id が
#    付きません。その結果 uid 1000（パスワード無しで root 昇格可）になります。
#    本プロジェクトは Open Terminal のポートを公開していないため実際には
#    到達できませんが、この 2 つは併せて維持してください。
USER_PERMISSIONS_FEATURES_DIRECT_TOOL_SERVERS=false
USER_PERMISSIONS_FEATURES_API_KEYS=false
USER_PERMISSIONS_FEATURES_AUTOMATIONS=false

# --- 管理者の越境 ---------------------------------------------------------
# ⚠️ これらは製品 UI 経路を塞ぐだけです。DB やインフラへの直接アクセスは別問題。
ENABLE_ADMIN_CHAT_ACCESS=false
ENABLE_ADMIN_EXPORT=false
#
# ⚠️ BYPASS_ADMIN_ACCESS_CONTROL を false にしてはいけません（upstream 既定は
#    true。config.py:2062 が ENABLE_ADMIN_WORKSPACE_CONTENT_ACCESS を継承する）。
#    false にすると main.py:1077 の条件が管理者でも真になり、管理者も
#    check_model_access を通ります。同関数は model テーブルに行が無いモデルを
#    問答無用で拒否するため（utils/models.py:447）、Workspace → Models に
#    登録していないモデルが「全員にとって」使用不能になります。
#
#    厄介なのは「見えるのに使えない」ことです。get_filtered_models は未登録
#    モデルを管理者には表示するため（utils/models.py:521-523 の
#    `elif user.role == 'admin'`）、モデルピッカーには並ぶのに、選んで送信すると
#    POST /api/chat/completions が 400 `Model not found` になります。
#    実測（2026-08-28）: プール 122 件 / Model エントリ 2 件の環境で、
#    チャット補完が通ったのは Model エントリのある 1 件だけでした。
#
#    一般ユーザ側の制限は下の BYPASS_MODEL_ACCESS_CONTROL=false が担うため、
#    ここを true にしても「一般ユーザが未登録モデルを使える」ようにはなりません。
BYPASS_ADMIN_ACCESS_CONTROL=true
BYPASS_MODEL_ACCESS_CONTROL=false

# --- 監査 -----------------------------------------------------------------
# ⚠️ AUDIT_LOG_LEVEL の既定は NONE です（env.py:1160）。
#    明示的に上げない限り何も記録されません。
AUDIT_LOG_LEVEL=REQUEST
ENABLE_AUDIT_LOGS_FILE=true

# --- セッション -----------------------------------------------------------
# ⚠️ 既定値は false のままにしてあります（env.py:726-732 の既定と同じ）。
#    WEBUI_URL の既定は http://localhost:8080 で、localhost はブラウザの
#    secure context 扱いなので手元では true でも動きますが、
#    http://<LAN の IP>:8080 のように HTTP のまま社内公開すると
#    ログインが黙って通らなくなります。HTTPS 化したタイミングで true に
#    してください。
WEBUI_AUTH_COOKIE_SECURE=false
WEBUI_AUTH_COOKIE_SAME_SITE=lax


# ------------------------------------------------------------------------------
# 19. docker-compose 用（Open WebUI 本体は参照しません）
# ------------------------------------------------------------------------------

POSTGRES_USER=openwebui
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=openwebui

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

OPEN_WEBUI_PORT=8080
MINIO_CONSOLE_PORT=9001

# --- docling-serve コンテナ（13 節の Basic RAG で使う抽出エンジン）---------
# ⚠️ 変換モデル（layout / tableformer / picture_classifier / rapidocr /
#    easyocr）はイメージに焼き込まれており、置き場は
#    /opt/app-root/src/.cache/docling/models（Containerfile の
#    DOCLING_SERVE_ARTIFACTS_PATH）です。**ここに名前付きボリュームを
#    張らないでください。** 空のボリュームで覆うと docling-serve は
#    モデルを自動ダウンロードせず実行時エラーにします。
#
# ⚠️ **ビルドが要ります。** 日本語 OCR の言語パックを足すため、compose は
#    docker/docling/Dockerfile からビルドした svc/docling-serve:local を
#    使います。ここで指定するのはその **ベースイメージのタグ**です。
DOCLING_SERVE_VERSION=latest

# 同期変換の待ち時間上限（秒）。既定 120 は大きな PDF に足りません。
# Open WebUI 側の呼び出しにはタイムアウトが無いため、実質この値が上限です。
DOCLING_SERVE_MAX_SYNC_WAIT=600

# 変換ワーカー数。CPU コア数と相談して決めてください。
DOCLING_SERVE_ENG_LOC_NUM_WORKERS=2

# CPU スレッド数（OpenMP / MKL）。
DOCLING_OMP_NUM_THREADS=4

DOCLING_SERVE_MEMORY_LIMIT=4G
DOCLING_SERVE_CPU_LIMIT=4.0

# Open WebUI Computer のポートは上の 15 節（OPEN_WEBUI_COMPUTER_PORT_A / _B / _C）にあります。
# Computer のイメージ関連（NODE_VERSION / PNPM_VERSION / CODEX_CLI_VERSION 等）は
# 上の 16 節にあります。
