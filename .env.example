# ==============================================================================
# ショート動画作成ツール - 環境変数テンプレート
# ==============================================================================
#
# 使い方:
#   cp .env.example .env  してから値を埋めてください。
#
# ⚠️ このリポジトリは public です（Functions を GitHub の raw URL から取り込むため）。
#    .env は .gitignore 済みですが、実際の鍵をこのテンプレート側に書き戻さないでください。
#
# 変数名はすべて Open WebUI v0.11.0 の実ソースと照合済みです。
#   backend/open_webui/env.py  … 起動時に読まれる（再起動が必要）
#   backend/open_webui/config.py … PersistentConfig。初回起動時に DB へ取り込まれ、
#                                  以降は管理画面の値が優先される（下記「※PC」参照）
#
# ※PC = PersistentConfig。環境変数は「初回の既定値」として働き、その後は
#        Admin Settings の値が正になります。値を変えたいときは管理画面で操作するか、
#        DB の config を消してから再起動してください。
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. 必須 — これが無いと動きません
# ------------------------------------------------------------------------------

# セッション JWT と OAuth トークンの暗号化に使う鍵。（env.py:716）
# v0.11.0 以降は未設定だと backend が起動しません。
# Descript MCP のような OAuth 連携ツールを使う場合、この値が変わると
# 保存済みトークンを復号できなくなり "Error decrypting tokens" が発生します。
# 複数レプリカ構成では全レプリカで必ず同一の値にしてください。
#   生成例: openssl rand -hex 32
WEBUI_SECRET_KEY=

# OAuth セッショントークンの暗号化鍵。未設定なら WEBUI_SECRET_KEY が使われます。
# 複数レプリカでは明示的に固定することを推奨します。
OAUTH_SESSION_TOKEN_ENCRYPTION_KEY=

# Functions / Tools（プラグイン）の実行を許可する。（env.py:1112）
# false にすると Actions / Filters / Pipes がすべて動きません。
ENABLE_PLUGINS=true

# 公開 URL。Web Search など一部機能が参照します。（config.py:1620）※PC
WEBUI_URL=http://localhost:8080


# ------------------------------------------------------------------------------
# 2. データベース（PostgreSQL）
# ------------------------------------------------------------------------------

# （env.py:267）パスワードに記号を含む場合は URL エンコードすること（@ → %40）
DATABASE_URL=postgresql://openwebui:CHANGE_ME@postgres:5432/openwebui

# コネクションプール。（env.py:302-324）
# 総接続数 = (POOL_SIZE + MAX_OVERFLOW) × プロセス数 × レプリカ数
# PostgreSQL の max_connections を超えないように設計してください。
DATABASE_POOL_SIZE=15
DATABASE_POOL_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# マイグレーション。（env.py:151）
# ⚠️ 複数レプリカ構成では 1 台だけ true にし、他は false にしてください。
#    全台で true だと同時マイグレーションで競合します。
ENABLE_DB_MIGRATIONS=true

# ユーザの最終アクティブ時刻を DB に書き戻す間隔（秒）。（env.py:356）
# 未設定だとリクエストごとに書き込みが走り、スケール時のボトルネックになります。
DATABASE_USER_ACTIVE_STATUS_UPDATE_INTERVAL=300


# ------------------------------------------------------------------------------
# 3. 共有状態ストア（Redis）
# ------------------------------------------------------------------------------
#
# ⚠️ 複数レプリカ / 複数ワーカー構成では Redis が必須です。
#    Functions が使う __event_emitter__ / __event_call__ は Socket.IO 経由で
#    ブラウザと通信しますが、WebSocket 接続を持つのは 1 つのレプリカだけです。
#    Redis 無しだと、別レプリカで動いた Pipe の進捗表示や入力フォームが
#    ユーザに届かず、__event_call__ は 300 秒でタイムアウトします。

REDIS_URL=redis://redis:6379/0

# （env.py:450 / :453 / :470）
ENABLE_WEBSOCKET_SUPPORT=true
WEBSOCKET_MANAGER=redis
WEBSOCKET_REDIS_URL=redis://redis:6379/0

# __event_call__（入力フォーム・確認ダイアログ）の応答待ち上限（秒）。（env.py:502）
# 既定 300。Functions 側の confirm_timeout_sec はこの値未満に設定してください。
WEBSOCKET_EVENT_CALLER_TIMEOUT=300

# Redis の健全性チェック間隔（秒）。長時間アイドル後の接続断対策。
REDIS_HEALTH_CHECK_INTERVAL=60


# ------------------------------------------------------------------------------
# 4. ベクトル DB（PGVector）
# ------------------------------------------------------------------------------
#
# ⚠️ 既定の ChromaDB は SQLite ベースで fork-safe ではないため、
#    UVICORN_WORKERS > 1 や複数レプリカ構成ではクラッシュします。必ず変更してください。

VECTOR_DB=pgvector

# （config.py:638）未指定なら DATABASE_URL が使われます。
PGVECTOR_DB_URL=postgresql://openwebui:CHANGE_ME@postgres:5432/openwebui

# ⚠️ text-embedding-3-large は 3072 次元です。
#    pgvector の通常インデックスは 2000 次元までなので halfvec が必須です。（config.py:645）
PGVECTOR_USE_HALFVEC=true
PGVECTOR_INITIALIZE_MAX_VECTOR_LENGTH=3072

# インデックス方式。（未指定なら作成しない）
PGVECTOR_INDEX_METHOD=hnsw
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64

# 非スーパーユーザで運用する場合は false にし、
# 事前に CREATE EXTENSION vector; を実行しておいてください。
PGVECTOR_CREATE_EXTENSION=true


# ------------------------------------------------------------------------------
# 5. 共有ファイルストレージ（MinIO / S3 互換）
# ------------------------------------------------------------------------------
#
# 制御対象はアップロードファイルのみです。DB とベクトル DB には影響しません。

STORAGE_PROVIDER=s3

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=open-webui
S3_REGION_NAME=ap-northeast-1

# MinIO は仮想ホスト形式の DNS を持たないため path 形式が必要です。（config.py:154）
S3_ADDRESSING_STYLE=path

# Cloudflare R2 を使う場合は必ず false にしてください（タグ API 非対応）。
S3_ENABLE_TAGGING=false


# ------------------------------------------------------------------------------
# 6. ワーカーと同時実行
# ------------------------------------------------------------------------------

# （env.py:442）
# ⚠️ 1 のままにして、スケールはコンテナのレプリカ数で行ってください。
#    2 以上にすると ChromaDB や pip install が競合します。
UVICORN_WORKERS=1

# 同期処理を逃がすスレッドプールのサイズ。（config.py:2081）
# 既定 40 は少なすぎて、同時接続が増えると応答が固まります。
THREAD_POOL_SIZE=2000

# より高速な JSON エンコーダ（v0.11.0 以降）。
ENABLE_ORJSON=true

# ロードバランサ / CDN 側で圧縮している場合は false にすると
# ワーカーあたり 3〜4% の CPU を削減できます。
# ENABLE_COMPRESSION_MIDDLEWARE=false


# ------------------------------------------------------------------------------
# 7. LLM プロバイダ（OpenAI）
# ------------------------------------------------------------------------------

ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# --- メイン LLM ---
# gpt-5.4-2026-03-05 を使います。
# ⚠️ 使用モデルは環境変数ではなく Workspace → Models のプリセットで指定します。
#    ここでは既定パラメータのみ設定します。

# ツール呼び出しは Native モード（v0.10.0 以降の既定かつ唯一のサポート対象）。
# ⚠️ FUNCTION_CALLING_MODE のような単独の環境変数は存在しません。
#    DEFAULT_MODEL_PARAMS の JSON 内のキーとして指定します。（config.py:1692）
DEFAULT_MODEL_PARAMS={"function_calling":"native"}

# --- タスクモデル（タイトル生成・タグ生成などの裏方処理）---
# メインモデルより軽量なものを指定すると遅延とコストを大幅に削減できます。（config.py:2158）※PC
TASK_MODEL_EXTERNAL=gpt-5.4-mini-2026-03-17

# --- Embedding（text-embedding-3-large / 3072 次元）---
RAG_EMBEDDING_ENGINE=openai                        # config.py:984  ※PC
RAG_EMBEDDING_MODEL=text-embedding-3-large         # config.py:990  ※PC
RAG_EMBEDDING_BATCH_SIZE=100
ENABLE_ASYNC_EMBEDDING=true

# --- 画像生成（gpt-image-2-2026-04-21）---
ENABLE_IMAGE_GENERATION=true                       # config.py:1310 ※PC
IMAGE_GENERATION_ENGINE=openai                     # config.py:1312 ※PC
IMAGE_GENERATION_MODEL=gpt-image-2-2026-04-21      # config.py:1314 ※PC
# gpt-image 系は IMAGE_AUTO_SIZE_MODELS_REGEX_PATTERN（既定 ^gpt-image）に
# マッチするため auto を指定できます。
IMAGE_SIZE=auto

# --- STT（gpt-transcribe）---
AUDIO_STT_ENGINE=openai                            # config.py:1545 ※PC
AUDIO_STT_MODEL=gpt-transcribe                     # config.py:1547 ※PC

# --- TTS（gpt-4o-mini-tts-2025-12-15）---
AUDIO_TTS_ENGINE=openai                            # config.py:1594 ※PC
AUDIO_TTS_MODEL=gpt-4o-mini-tts-2025-12-15         # config.py:1597 ※PC
AUDIO_TTS_VOICE=alloy                              # config.py:1599 ※PC

# --- Realtime（gpt-realtime-2.1）---
# ⚠️ 未確定 / 現時点では設定不可。
#    Open WebUI v0.11.0 には OpenAI Realtime API に接続するための設定項目が
#    存在しません（ENABLE_REALTIME_CHAT_SAVE は「ストリーミング中にトークン毎に
#    DB へ書き込む」という別機能で、本番では有効化しないでください）。
#    Voice Mode は ENABLE_VOICE_MODE_PROMPT / VOICE_MODE_PROMPT_TEMPLATE という
#    プロンプト設定のみで、Realtime API の接続設定ではありません。
#    Realtime を使う場合は別途 Pipe Function として実装する必要があります。
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1   ← 存在しない変数。設定しても無視されます


# ------------------------------------------------------------------------------
# 8. Web 検索（Tavily）
# ------------------------------------------------------------------------------

ENABLE_WEB_SEARCH=true                             # config.py:1129 ※PC
WEB_SEARCH_ENGINE=tavily                           # config.py:1138 ※PC
TAVILY_API_KEY=                                    # config.py:1266 ※PC
TAVILY_EXTRACT_DEPTH=basic                         # config.py:1268 ※PC
WEB_SEARCH_RESULT_COUNT=3


# ------------------------------------------------------------------------------
# 9. MCP（Descript MCP）
# ------------------------------------------------------------------------------
#
# ⚠️ Descript MCP は環境変数では設定できません。
#    管理画面から登録してください:
#      Admin Settings → External Tools → ＋
#        Type:      MCP (Streamable HTTP)
#        URL:       https://api.descript.com/v2/mcp
#        Auth:      OAuth 2.1
#        → Register Client → Save
#    登録後に表示される info.id を、Functions の Valve
#    `mcp_server_id`（descript_pipe / descript_guard）に設定します。
#
#    さらに、各ユーザがチャット入力欄の ＋ → Integrations → Tools から
#    Descript を一度手動で有効化し、OAuth 同意を完了する必要があります。
#    ⚠️ この MCP をモデルのデフォルトツールに設定してはいけません
#       （チャット補完リクエスト中にブラウザリダイレクトを起こせないため）。
#
#    詳細は docs/Setup/descript_functions_setup.md を参照してください。

# MCP セッション初期化のタイムアウト（秒）。（env.py:653）
# 既定 10 秒。"Failed to connect to MCP server" が出る場合は増やしてください。
MCP_INITIALIZE_TIMEOUT=30

# 外部ツールサーバへユーザ情報ヘッダを転送する。
# Descript MCP 側では使いませんが、監査ログを取る場合に有用です。
ENABLE_FORWARD_USER_INFO_HEADERS=false


# ------------------------------------------------------------------------------
# 10. 認証（Google OAuth / OIDC）
# ------------------------------------------------------------------------------

ENABLE_OAUTH_SIGNUP=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPE=openid email profile
GOOGLE_REDIRECT_URI=https://XXXX/oauth/google/callback
OPENID_PROVIDER_URL=https://accounts.google.com/.well-known/openid-configuration

# 本番では短めにしてください。
JWT_EXPIRES_IN=4h

# スケール時のセキュリティ既定の見直し。
ENABLE_PROFILE_IMAGE_URL_FORWARDING=false
ENABLE_OAUTH_ID_TOKEN_COOKIE=false


# ------------------------------------------------------------------------------
# 11. プラグインの依存関係インストール
# ------------------------------------------------------------------------------
#
# Functions の frontmatter に書かれた requirements を pip install するかどうか。
#
# ⚠️ 本番では false を推奨します。理由:
#    ① 任意パッケージのインストールを防げる
#    ② UVICORN_WORKERS > 1 や複数レプリカで同時 pip install が走ると
#       競合でワーカーがクラッシュする
#    ③ デプロイが再現可能になる
#
#    本プロジェクトの 3 つの Functions は requirements を空にしてあり、
#    Open WebUI 同梱の mcp / httpx / pydantic と標準ライブラリしか使いません。
#    したがって false でも動作します。
ENABLE_PIP_INSTALL_FRONTMATTER_REQUIREMENTS=false


# ------------------------------------------------------------------------------
# 12. PWA / ブランディング
# ------------------------------------------------------------------------------
#
# Open WebUI のインスタンスはそのまま PWA として動作します（追加設定不要）。
# ブラウザの「ホーム画面に追加」/「インストール」でスタンドアロンアプリになります。
# ⚠️ ENABLE_PWA のような変数は存在しません。

WEBUI_NAME=ショート動画作成ツール

# アプリ名・アイコン・テーマカラーを差し替える場合は
# 外部の manifest を指定します。（env.py:951）
# EXTERNAL_PWA_MANIFEST_URL=https://example.com/manifest.webmanifest


# ------------------------------------------------------------------------------
# 13. コンテンツ抽出（任意）
# ------------------------------------------------------------------------------
#
# 既定の pypdf は本番規模には向きません。文書 RAG を使う場合は Tika を推奨します。
# CONTENT_EXTRACTION_ENGINE=tika
# TIKA_SERVER_URL=http://tika:9998


# ------------------------------------------------------------------------------
# 14. Open Terminal（AI の実行環境）
# ------------------------------------------------------------------------------
#
# docker-compose.yml の open-terminal サービス用の設定です。
# Open WebUI 本体はこれらの OPEN_TERMINAL_* を読みません。compose が
# コンテナへ渡すために参照します（Open WebUI 側は下の接続定義だけ見ます）。
#
# 接続定義 TERMINAL_SERVER_CONNECTIONS は docker-compose.yml の
# open-webui サービス内で組み立てているため、ここには書きません。
# 単体で Open WebUI を動かす場合だけ、以下の形で指定してください。※PC
#   TERMINAL_SERVER_CONNECTIONS=[{"id":"open-terminal","name":"作業用ターミナル","url":"http://open-terminal:8000","key":"<OPEN_TERMINAL_API_KEY と同じ値>","auth_type":"bearer","enabled":true,"config":{"access_grants":[{"principal_type":"user","principal_id":"*","permission":"read"}]}}]
#
# ⚠️ この変数は config.py:386 で json.loads されますが、TOOL_SERVER_CONNECTIONS と
#    違って try/except がありません。JSON を壊すと Open WebUI が起動しません。
# ⚠️ ※PC なので取り込まれるのは初回起動時だけです。値を変えたら
#    Admin Settings → Integrations → Open Terminal で直すか、
#    DB の terminal_server.connections を削除してから再起動してください。
# ⚠️ access_grants を空にすると管理者しか使えません
#    （utils/access_control/__init__.py:167）。

# ターミナルの認証キー。v0.11.30 以降は未設定だと Open Terminal が起動しません。
# このキーを持っていれば誰でもコマンドを実行できるため、必ず強い値にしてください。
#   生成例: openssl rand -hex 32
OPEN_TERMINAL_API_KEY=

# 同時ターミナルセッション数の上限。既定 16。
OPEN_TERMINAL_MAX_SESSIONS=16

# コマンド出力を待つ秒数。未設定だと無期限に待ちます。
# ffmpeg のエンコードを走らせる想定で長めにしています。
OPEN_TERMINAL_EXECUTE_TIMEOUT=600

# 暴走したスクリプト対策のリソース上限（compose の deploy.resources.limits）。
OPEN_TERMINAL_MEMORY_LIMIT=2G
OPEN_TERMINAL_CPU_LIMIT=2.0

# 検証時にホストへ直接公開する場合のポート。
# docker-compose.yml 側の ports がコメントアウトされているため、
# 有効化しない限りこの値は使われません。
OPEN_TERMINAL_PORT=8000


# ------------------------------------------------------------------------------
# 15. docker-compose 用（Open WebUI 本体は参照しません）
# ------------------------------------------------------------------------------

POSTGRES_USER=openwebui
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=openwebui

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

OPEN_WEBUI_PORT=8080
MINIO_CONSOLE_PORT=9001
